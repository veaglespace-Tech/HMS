# ─── DATABASE ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=Root@2026
MYSQL_DATABASE=arogya_hms
MYSQL_USER=arogya
MYSQL_PASSWORD=Arogya@2026

# For local dev (non-Docker) — point to localhost
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/arogya_hms?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Root

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=Redis@2026
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ─── MINIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=arogya-minio
MINIO_SECRET_KEY=Minio@2026!
MINIO_BUCKET=arogya-docs

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32 chars) for HS256
JWT_SECRET=ArogyaHmsSuperSecretKey2026MustBeAtLeast256BitsLongForHS256
JWT_EXPIRY_MS=86400000

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@arogya.in
SMTP_PASS=changeme
# Set to true to skip actual email sending in dev (logs to console instead)
EMAIL_DEV_MODE=true

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Arogya HMS

# ─── SUPER ADMIN (seed — change after first login) ───────────────────────────
SUPER_ADMIN_EMAIL=superadmin@arogya.in
SUPER_ADMIN_TEMP_PASSWORD=Arogya@2026!
